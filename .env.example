APP_NAME=entrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=entrack
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- ML / Python service -----------------------------------------------
# Path to the Python executable inside python-service's virtualenv.
# This is the ONE thing that has to change per machine -- everything else
# in python-service resolves its own paths relative to the project root.
#
#   Windows example: C:\path\to\entrack\.venv-ml\Scripts\python.exe
#   macOS/Linux example: /path/to/entrack/.venv-ml/bin/python
#
# If unset, defaults to "python3" on PATH.
ML_PYTHON_BIN=python3

# Fallback DB credentials used only when running a python-service script by
# hand (php always passes DB_HOST/DB_USERNAME/DB_PASSWORD/DB_DATABASE above
# into the subprocess automatically). Optional.
# ML_DB_HOST=127.0.0.1
# ML_DB_PORT=3306
# ML_DB_NAME=entrack
# ML_DB_USER=root
# ML_DB_PASSWORD=
